{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Zurich",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "NetBox-Image: nur stabile Tags vX.Y.Z (keine Betas, keine netbox-docker-Suffixe)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/netbox-community/netbox"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "NetBox und Plugins immer zusammen in EINEM PR – so wird die Kombination getestet",
      "matchManagers": ["dockerfile", "pip_requirements"],
      "groupName": "NetBox und Plugins"
    },
    {
      "description": "Patch- und Minor-Updates automatisch mergen, sobald die CI grün ist",
      "matchManagers": ["dockerfile", "pip_requirements"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Major-Updates (z.B. NetBox 4 -> 5) nur manuell",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update"]
    },
    {
      "description": "GitHub Actions gesammelt und automatisch aktualisieren",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": true
    }
  ]
}
